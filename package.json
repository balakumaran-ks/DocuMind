{
  "name": "documind",
  "version": "0.1.0",
  "private": true,
  "description": "Chat with your PDFs: upload a document, ask questions, get answers with page-level citations.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project components",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "diagrams": "node scripts/render-diagrams.mjs",
    "db:indexes": "node --env-file=.env.local scripts/create-indexes.ts",
    "eval": "node --env-file=.env.local --import ./scripts/register-alias.mjs scripts/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.90",
    "ai": "^7.0.130",
    "mongodb": "^7.7.0",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": ".cache/mongodb-binaries"
    }
  }
}
