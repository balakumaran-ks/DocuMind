# Copy to .env.local and fill in. Never commit real values.
# `npm run dev` then GET /api/health shows which required values are still missing.

# --- MongoDB Atlas (free M0 cluster) ---
# Atlas > Database > Connect > Drivers. Needs Atlas Vector Search (included on M0).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=documind

# --- Gemini API (https://aistudio.google.com/apikey) ---
# Read by the Vercel AI SDK Google provider.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional overrides. Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match numDimensions in the Atlas vector index. Changing it means re-embedding.
EMBEDDING_DIMENSIONS=768

# --- Auth.js with Google sign-in ---
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
