# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rendered-diagram scratch output
/docs/diagrams/.render/

# local only: personal notes and coding-assistant instructions
/private/
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.claude/

# MongoDB binary for integration tests (config.mongodbMemoryServer in package.json)
/.cache/
